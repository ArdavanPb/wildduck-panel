# ── Configuration ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All settings have sensible defaults; only change what you need.
#
# Quick-start (local):
#   1. cp .env.example .env
#   2. Edit .env with your WildDuck API details.
#   3. pip install -r requirements.txt
#   4. python app.py
#
# Quick-start (Docker):
#   1. cp .env.example .env
#   2. Edit .env with your settings and uncomment the environment
#      section in docker-compose.yml.
#   3. docker compose up -d

# WildDuck REST API base URL
WILDDUCK_API_URL=http://127.0.0.1:8080

# API access token (sent as X-Access-Token header on every request)
WILDDUCK_API_TOKEN=

# Panel admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Flask session signing key (change to a random string!)
FLASK_SECRET_KEY=a-very-secret-key

# Enable Flask debug mode (true/false)
FLASK_DEBUG=false
